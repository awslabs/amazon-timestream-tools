        {
          "query": "import \"strings\"\nimport \"experimental/json\"\nimport \"date\"\n\nfrom(bucket: \"mybucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) =>\n      r._measurement == \"spans\" and\n      r._field == \"attributes\" and\n      strings.containsStr(v: r._value, substr: \"gen_ai.event.end_time\")\n  )\n  |> map(fn: (r) => {\n      attrs       = json.parse(data: bytes(v: r._value))\n      start_time  = time(v: attrs[\"gen_ai.event.start_time\"])\n      end_time    = time(v: attrs[\"gen_ai.event.end_time\"])\n      duration_s  = (int(v: end_time) - int(v: start_time)) / 1000000000\n      return {\n        _time:       r._time,\n        _field:      \"duration\",\n        _value:      duration_s,\n        agent_name:  attrs[\"gen_ai.agent.name\"],\n        operation:   attrs[\"gen_ai.operation.name\"],\n      }\n    })\n  |> filter(fn: (r) => r.operation == \"invoke_agent\")\n  |> group(columns: [\"agent_name\"])\n  |> aggregateWindow(\n       every: 1000ms,\n       fn: sum,\n       column: \"_value\",\n       createEmpty: true\n    )\n  |> filter(fn: (r) => exists r._value)\n  ",
          "refId": "A"
        }
      ],
      "title": "Invocations over time",
      "type": "timeseries"
    },
