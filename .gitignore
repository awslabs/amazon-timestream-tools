**/.DS_Store

# Ignore common dotnet files
bin/
obj/

# Ignore common Java files
.idea/
*.iml
target/

# Ignore common Python files
**/venv
**/.DS_Store
**/__pycache__/**
**/.env
**/.venv
**/env/
**/venv/
**/ENV/
**/env.bak/
**/venv.bak/

# Ignore common JS files
node_modules

# Ignore AWS Influx migration script backup and performance files and directories
tools/python/influx-migration/**/performance.txt
tools/python/influx-migration/**/*influxdb-backup-*
tools/python/influx-migration/**/scripts/temp/*

# Ignore files generated by sample applications
**/query_results.log

# LiveAnalytics to InfluxDB migration log files
**/influxdb-ingestion-logs/**

# LiveAnalytics migration to InfluxDB generated test data
tools/python/liveanalytics_migration_scripts/targets/timestream_for_influxdb/ingestion/ingestion-tests/test-data/*
!tools/python/liveanalytics_migration_scripts/targets/timestream_for_influxdb/ingestion/ingestion-tests/test-data/valid/*.gz
!tools/python/liveanalytics_migration_scripts/targets/timestream_for_influxdb/ingestion/ingestion-tests/test-data/invalid/*.gz
