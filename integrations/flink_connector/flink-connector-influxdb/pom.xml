<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>software.amazon.timestream</groupId>
    <artifactId>flink-connector-timestream-influxdb3</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Flink Connector for Amazon Timestream for InfluxDB 3</name>
    <description>An Apache Flink DataStream and Table API sink for Amazon Timestream for InfluxDB 3.</description>
    <packaging>jar</packaging>
    <url>https://github.com/awslabs/amazon-timestream-tools/tree/mainline/integrations/flink_connector/flink-connector-influxdb</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>amazonwebservices</id>
            <organization>Amazon Web Services</organization>
            <organizationUrl>https://aws.amazon.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/awslabs/amazon-timestream-tools/tree/mainline/integrations/flink_connector/flink-connector-influxdb</url>
        <connection>scm:git:https://github.com/awslabs/amazon-timestream-tools.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/awslabs/amazon-timestream-tools.git</developerConnection>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <flink.version>2.3.0</flink.version>
        <influxdb3.version>1.10.0</influxdb3.version>
        <aws.sdk.version>2.31.78</aws.sdk.version>
        <jackson.version>2.21.0</jackson.version>
        <grpc.version>1.81.0</grpc.version>
        <netty.version>4.2.15.Final</netty.version>
        <slf4j.version>1.7.36</slf4j.version>

        <junit.version>5.12.1</junit.version>
        <assertj.version>3.27.3</assertj.version>
        <wiremock.version>3.12.1</wiremock.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <maven.compiler.version>3.14.0</maven.compiler.version>
        <maven.surefire.version>3.5.3</maven.surefire.version>
        <maven.failsafe.version>3.5.3</maven.failsafe.version>
        <maven.source.version>3.3.1</maven.source.version>
        <maven.javadoc.version>3.11.2</maven.javadoc.version>
        <maven.jar.version>3.4.2</maven.jar.version>
        <maven.gpg.version>3.2.8</maven.gpg.version>
        <central.publishing.version>0.12.0</central.publishing.version>
        <jacoco.version>0.8.14</jacoco.version>
        <jacoco.minimum.line.coverage>0.80</jacoco.minimum.line.coverage>
        <jacoco.minimum.branch.coverage>0.75</jacoco.minimum.branch.coverage>
        <jacocoArgLine/>
        <skipITs>true</skipITs>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Flink does not publish a consumer BOM; centrally manage every used module. -->
